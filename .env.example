# ---------------------------------------------------------------------------
# Local development
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# Verify with: npm run check-env
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# DATABASE_URL  — pooled connection (PgBouncer, port 6543). Used at runtime.
#                 The ?pgbouncer=true parameter is required; without it Prisma
#                 raises "prepared statement s0 already exists" under load.
# DIRECT_URL    — direct connection (port 5432). Used by Prisma Migrate, which
#                 needs a session-mode connection and cannot run via the pooler.
#
# Supabase → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---------------------------------------------------------
# Supabase → Project Settings → API
#
# NOTE: NEXT_PUBLIC_* values are inlined into the bundle at BUILD time.
# Changing them requires a rebuild/redeploy — restarting is not enough.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"

# Server-only. Bypasses Row Level Security entirely.
# Never expose to the browser, never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- Optional --------------------------------------------------------------
# Enables the scheduler on /consultation. Without it, consultation requests
# are stored for staff follow-up instead — the feature works either way.
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-handle/30min"
