# ---------------------------------------------------------------------------
# Production (Vercel)
#
# These are set in the Vercel dashboard, NOT in a file. This template exists
# so you can see the exact shape each value must take.
#
#   Vercel → Project → Settings → Environment Variables → Environment: Production
#
# After adding or changing any of these you MUST redeploy. NEXT_PUBLIC_*
# values are inlined into the JavaScript bundle at build time, so an existing
# deployment keeps whatever it was built with. This is exactly what caused the
# site-wide MIDDLEWARE_INVOCATION_FAILED outage.
#
# Verify before deploying:  npm run check-env:strict
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Pooled. Port 6543. ?pgbouncer=true is mandatory on serverless.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct. Port 5432. Required by Prisma Migrate; the pooler cannot run DDL.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---------------------------------------------------------
# Safe to expose to the browser. Inlined at build time.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"

# SECRET. Bypasses Row Level Security. Server-only.
# If this ever leaks, rotate it immediately in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- Optional --------------------------------------------------------------
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-handle/30min"

# ---------------------------------------------------------------------------
# Notes on values that commonly go wrong
#
#   connection_limit=1  — recommended on Vercel. Each serverless invocation
#                         gets its own connection; without a low limit you can
#                         exhaust Supabase's pool under modest traffic.
#
#   Password encoding   — if the database password contains @ : / ? # [ ] or %
#                         it must be percent-encoded inside the URL, or the
#                         connection string will parse incorrectly.
#
#   Wrong port          — DATABASE_URL on 5432 works but loses pooling.
#                         DIRECT_URL on 6543 makes migrations hang or fail.
# ---------------------------------------------------------------------------
